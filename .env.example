# Copy this file to .env and fill in. Never commit .env (it is in .gitignore).

# Google AI Studio key (https://aistudio.google.com). Without it, BatchWatch runs in offline fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Force offline mode even if a key is set (e.g. during a demo with bad Wi-Fi)
# BATCHWATCH_OFFLINE=1

# Optional email notifications (e.g. Gmail with an App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFY_EMAIL_TO=you@gmail.com
